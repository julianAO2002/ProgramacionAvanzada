# Variables de entorno del TP5
# Copiar este archivo a .env antes de levantar los contenedores (cp .env.example .env)

# Postgres
POSTGRES_USER=task_user
POSTGRES_PASSWORD=task_pass
POSTGRES_DB=task_db

# Zona horaria de la base y de la API (define cual es la "fecha de hoy")
TZ=America/Argentina/Buenos_Aires

# Puertos expuestos en la maquina host
WEB_HOST_PORT=8080
API_HOST_PORT=3001
DB_HOST_PORT=5433
